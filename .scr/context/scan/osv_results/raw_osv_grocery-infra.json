          "vulnerabilities": [
            {
              "modified": "2026-02-28T06:44:02Z",
              "published": "2026-02-26T22:07:15Z",
              "schema_version": "1.7.3",
              "id": "GHSA-23c5-xmqv-rm74",
              "aliases": [
