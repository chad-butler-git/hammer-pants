          "vulnerabilities": [
            {
              "modified": "2026-03-02T12:59:05Z",
              "published": "2026-02-25T22:37:26Z",
              "schema_version": "1.7.3",
              "id": "GHSA-mw96-cpmx-2vgc",
              "aliases": [
                "CVE-2026-27606"
